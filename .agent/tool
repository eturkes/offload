#!/usr/bin/env bash
# tool — run one pinned gate tool, fetched once into gitignored .tools/. Release assets are refused
# unless their sha256 matches the pin; go-installed tools are verified by the Go checksum database.
# Pins cover Linux x86_64 alone (controller + CI). Bump = new version + digest from the release page.
#   .agent/tool <name> [args…]
#   .agent/tool --pins          `<name> <version> <source>` per pin (source = github:<owner>/<repo> |
#                               go:<module>), read by `.agent/pins`
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
names="golangci-lint betterleaks actionlint shellcheck nixfmt govulncheck gotestsum mutago"
gh=https://github.com
spec() { # spec <name>: sets v + (sum, url, member) | pkg
case $1 in
  golangci-lint) v=2.15.0 sum=9b7fe6a6bf6334b98decf8d86b11415ea7889afdabdd1959fdce23af2a9ebcea
    url=$gh/golangci/golangci-lint/releases/download/v$v/golangci-lint-$v-linux-amd64.tar.gz
    member=golangci-lint-$v-linux-amd64/golangci-lint ;;
  betterleaks) v=1.9.0 sum=f8b185a39ffcece2a1ca82bf3a4e7435cd81963ffd16b7a9128daf75f35f6de7
    url=$gh/betterleaks/betterleaks/releases/download/v$v/betterleaks_${v}_linux_x64.tar.gz
    member=betterleaks ;;
  actionlint) v=1.7.12 sum=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
    url=$gh/rhysd/actionlint/releases/download/v$v/actionlint_${v}_linux_amd64.tar.gz
    member=actionlint ;;
  shellcheck) v=0.11.0 sum=8c3be12b05d5c177a04c29e3c78ce89ac86f1595681cab149b65b97c4e227198
    url=$gh/koalaman/shellcheck/releases/download/v$v/shellcheck-v$v.linux.x86_64.tar.xz
    member=shellcheck-v$v/shellcheck ;;
  nixfmt) v=1.5.0 sum=aa029247ab89c897e2f3948463967553f902f86e86e3402fa28cb29c4a44f745
    url=$gh/NixOS/nixfmt/releases/download/v$v/nixfmt
    member= ;;
  govulncheck) v=1.9.0 pkg=golang.org/x/vuln/cmd/govulncheck ;;
  gotestsum) v=1.13.0 pkg=gotest.tools/gotestsum ;;
  mutago) v=2.10.35 pkg=github.com/quality-gates/mutago/v2/cmd/mutago ;; # mutation credit, not a gate step
  *) echo "tool: unknown tool $1" >&2; exit 2 ;;
esac
}
if [ "${1:-}" = --pins ]; then
  for n in $names; do
    url='' pkg=''
    spec "$n"
    if [ -n "$pkg" ]; then src=go:${pkg%%/cmd/*}; else src=github:$(echo "$url" | cut -d/ -f4,5); fi
    echo "$n $v $src"
  done
  exit 0
fi
name=${1:?usage: .agent/tool <name> [args...]}
shift
[ "$(uname -sm)" = "Linux x86_64" ] || { echo "tool: pins cover Linux x86_64 alone" >&2; exit 2; }
spec "$name"

dir=$root/.tools/$name-$v
bin=$dir/$name
if [ ! -x "$bin" ]; then
  mkdir -p "$dir"
  if [ -n "${pkg:-}" ]; then
    GOBIN=$dir GOFLAGS=-mod=mod go install "$pkg@v$v"
  else
    dl=$dir/download
    curl -fsSL -o "$dl" "$url"
    if ! echo "$sum  $dl" | sha256sum -c --status; then
      rm -f "$dl"
      echo "tool: sha256 mismatch for $url; refusing it" >&2
      exit 2
    fi
    case $url in
      *.tar.gz) tar -xzf "$dl" -O "$member" > "$bin" ;;
      *.tar.xz) tar -xJf "$dl" -O "$member" > "$bin" ;;
      *) mv "$dl" "$bin" ;;
    esac
    rm -f "$dl"
    chmod +x "$bin"
  fi
fi
exec "$bin" "$@"
