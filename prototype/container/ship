#!/usr/bin/env bash
# ship save|registry — put the gate image + ctr on the pool host; prints one `ship:` line
# (method, seconds, bytes over the wire, image id on both sides).
#   save      podman save | zstd | ssh podman load (whole image every time)
#   registry  controller-local registry (127.0.0.1:5005) + ssh -R tunnel; host pulls only
#             layers it lacks
#   SHIP_HOST  ssh target (default offload@192.168.40.240 = nixbox; hard-coded for the spike)
set -euo pipefail
image=${CTR_IMAGE:-localhost/cement-gate:proto}
host=${SHIP_HOST:-offload@192.168.40.240}
here=$(dirname "$(readlink -f "$0")")
ssh=(ssh -o BatchMode=yes "$host")
port=5005
t0=$EPOCHREALTIME
case ${1:-} in
  save)
    count=$(mktemp)
    podman save "$image" | zstd -q -T0 -3 | tee >(wc -c >"$count") | "${ssh[@]}" 'zstd -dq | podman load -q' >/dev/null
    sleep 0.2
    bytes=$(cat "$count")
    rm -f "$count"
    ;;
  registry)
    if ! podman container exists ctr-registry; then
      podman run -d --name ctr-registry -p 127.0.0.1:$port:5000 \
        docker.io/library/registry:3@sha256:1290056e2357eceb0c047cb60ae9abb370305a218e2df650eb8d3ea021b1c151 >/dev/null
    fi
    podman start ctr-registry >/dev/null
    until curl -sf "http://127.0.0.1:$port/v2/" >/dev/null; do sleep 0.2; done
    remote=127.0.0.1:$port/cement-gate:proto
    podman push -q --tls-verify=false "$image" "$remote"
    log=$(mktemp)
    since=$(date -u +%Y-%m-%dT%H:%M:%S.%NZ)
    "${ssh[@]}" -R "$port:127.0.0.1:$port" \
      "podman pull --tls-verify=false $remote && podman tag $remote $image" >"$log" 2>&1 \
      || { cat "$log" >&2; exit 1; }
    # Bytes = what the registry served: GET blob responses since the pull began (podman's non-tty
    # pull output lists present blobs too).
    bytes=$(podman logs --since "$since" ctr-registry 2>&1 | grep 'http.request.method=GET' \
      | grep '/blobs/' | sed -n 's/.*http.response.written=\([0-9]*\).*/\1/p' | awk '{s+=$1} END {print s+0}')
    rm -f "$log"
    ;;
  *) sed -n '2,8s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
"${ssh[@]}" 'mkdir -p ~/.local/share/offload-proto' && scp -q "$here/ctr" "$host:.local/share/offload-proto/ctr"
local_id=$(podman image inspect --format '{{.Id}}' "$image")
remote_id=$("${ssh[@]}" "podman image inspect --format '{{.Id}}' $image")
printf 'ship: %s %.1fs %s bytes local=%.12s remote=%.12s %s\n' "$1" \
  "$(awk -v a="$t0" -v b="$EPOCHREALTIME" 'BEGIN{print b-a}')" "$bytes" "$local_id" "$remote_id" \
  "$([ "$local_id" = "$remote_id" ] && echo same || echo DIFFERENT)"
