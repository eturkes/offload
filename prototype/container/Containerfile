# cement gate image: one Python build + one uv on every host ⇒ D28 verdict keys (sys.version,
# sqlite3 version) match across controller + pool. Build: `podman build -t localhost/cement-gate:proto prototype/container`.
FROM ghcr.io/astral-sh/uv:0.13.1@sha256:9a853e40f2eb00f980d265a84fba919dc38ff17750197e7f13c055e4e2f12edd AS uv

FROM docker.io/library/debian:trixie-slim@sha256:4876fdea29cac1a33a3195f1eb1952feb1fca7dd6dd00be3e2f1879cf20d34d2
# Gate needs: git (D28 worktrees, gitleaks history), curl + tar + gzip (gitleaks fetch), awk.
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates curl tar gzip gawk procps \
 && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /uvx /usr/local/bin/
ENV UV_PYTHON_INSTALL_DIR=/opt/uv-python \
    UV_PYTHON_PREFERENCE=only-managed \
    UV_PYTHON=3.13.16 \
    LANG=C.UTF-8
# Bytecode precompiled: the stdlib is root-owned + read-only to the keep-id user, so without it every
# process recompiles its imports (python spawn 4x slower than native).
RUN uv python install 3.13.16 \
 && /opt/uv-python/cpython-3.13.16-*/bin/python3 -m compileall -q -j0 /opt/uv-python \
 && chmod -R a+rX /opt/uv-python
# Runtime: no further Python downloads; venv + cache live outside the image (ctr bind-mounts them).
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/venv \
    UV_CACHE_DIR=/uv-cache \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1
# Suites commit in scratch repos ⇒ an identity; the image's, so every host commits alike.
RUN git config --system user.name ctr \
 && git config --system user.email ctr@offload.invalid \
 && git config --system safe.directory '*'
