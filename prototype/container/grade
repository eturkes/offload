#!/usr/bin/env bash
# grade <step> — the spike's fixed check (`.agent/spec.md` Decisions, pool run environment), run
# against a cement clone (CEMENT, default .scratch/cement; made by `grade clone`). Each step prints
# its result lines; record them in results.md. nixbox steps call ctr at the path `ship` installs
# (~/.local/share/offload-proto/ctr, out of band, not in machines/nixbox: spike shortcut).
#   clone             git clone ~/Projects/cement at HEAD + copy its D28 verdict store
#   hits              d28-hits: native + image, controller + nixbox (no replay)
#   one               d28-one in the image on the controller (one cold replay, ~5 min, heavy slot)
#   gate <where> <env>  .agent/gate --omit-d28; where = local (heavy) | nixbox; env = native | ctr
#   bump              rebuild with one extra apt package, ship both ways (bytes, seconds)
set -uo pipefail
here=$(dirname "$(readlink -f "$0")")
repo=$(git -C "$here" rev-parse --show-toplevel)
cement=${CEMENT:-$repo/.scratch/cement}
ctr_remote='"$HOME/.local/share/offload-proto/ctr"'
secs() { awk -v a="$1" -v b="$EPOCHREALTIME" 'BEGIN{printf "%.1f", b - a}'; }
native_py='UV_PYTHON=3.13 uv run --locked -q python -c "$1"'
ctr_py='uv run --locked -q python -c "$1"'
case ${1:-} in
  clone)
    git clone -q ~/Projects/cement "$cement" || exit
    cp -a "$(git -C ~/Projects/cement rev-parse --path-format=absolute --git-common-dir)/cement-d28-verdicts" \
      "$cement/.git/"
    echo "clone: $(git -C "$cement" rev-parse --short HEAD) verdicts=$(ls "$cement/.git/cement-d28-verdicts" | wc -l)"
    ;;
  hits)
    cd "$cement" || exit
    s=$(cat "$here/d28-hits")
    printf 'controller native: '; bash -c "$native_py" _ "$s"
    printf 'controller ctr:    '; "$here/ctr" bash -c "$ctr_py" _ "$s"
    printf 'nixbox native:     '; offload run --host nixbox -- bash -c "$native_py" _ "$s" 2>/dev/null
    printf 'nixbox ctr:        '; offload run --host nixbox -- bash -c "$ctr_remote bash -c '$ctr_py' _ \"\$1\"" _ "$s" 2>/dev/null
    ;;
  one)
    cd "$cement" || exit
    heavy "$here/ctr" uv run --locked -q python -c "$(cat "$here/d28-one")"
    ;;
  gate)
    cd "$cement" || exit
    case ${2:-}-${3:-} in
      local-native) cmd=(heavy env UV_PYTHON=3.13 bash -c 'uv sync --locked -q && .agent/gate --omit-d28') ;;
      local-ctr) cmd=(heavy "$here/ctr" bash -c 'uv sync --locked -q && .agent/gate --omit-d28') ;;
      nixbox-native) cmd=(offload run --host nixbox -- env UV_PYTHON=3.13 bash -c 'uv sync --locked -q && .agent/gate --omit-d28') ;;
      nixbox-ctr) cmd=(offload run --host nixbox -- bash -c "$ctr_remote bash -c 'uv sync --locked -q && .agent/gate --omit-d28'") ;;
      *) sed -n '2,11s/^# \{0,1\}//p' "$0"; exit 2 ;;
    esac
    t0=$EPOCHREALTIME
    "${cmd[@]}"
    rc=$?
    echo "gate $2 $3: rc=$rc wall=$(secs "$t0")s (wall includes slot wait + sync)"
    exit "$rc"
    ;;
  bump)
    tmp=$(mktemp -d)
    sed 's/gawk procps/gawk procps zstd/' "$here/Containerfile" >"$tmp/Containerfile"
    t0=$EPOCHREALTIME
    podman build -q -t localhost/cement-gate:bump -f "$tmp/Containerfile" "$here" >/dev/null || exit
    echo "bump build: $(secs "$t0")s"
    rm -rf "$tmp"
    CTR_IMAGE=localhost/cement-gate:bump "$here/ship" registry
    CTR_IMAGE=localhost/cement-gate:bump "$here/ship" save
    ;;
  *) sed -n '2,11s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
