#!/usr/bin/env bash
# ctr <cmd…> — run <cmd…> in the gate image: the cwd's git root bind-mounted at its own path (git
# worktree paths stay valid), venv + uv cache in per-host dirs outside the project (ignored state
# stays per side, the host's own .venv untouched). Same script on controller + pool hosts.
#   CTR_IMAGE  image (default localhost/cement-gate:proto)
set -euo pipefail
image=${CTR_IMAGE:-localhost/cement-gate:proto}
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
key=$(basename "$root")-$(printf %s "$root" | sha1sum | cut -c1-8)
cache=${XDG_CACHE_HOME:-$HOME/.cache}/ctr
mkdir -p "$cache/$key/venv" "$cache/uv"
name=ctr-$key-$$
# TERM/INT/HUP reach podman via the process group; sig-proxy forwards them, --init's PID 1 exits
# with the command and the pid namespace dies with it. SIGKILL of podman leaves conmon running ⇒
# this trap removes the container on any catchable exit.
trap 'podman rm -f -t 2 "$name" >/dev/null 2>&1 || true' EXIT
podman run --rm --init --name "$name" --userns=keep-id -e HOME=/tmp \
  -v "$root:$root" -w "$PWD" \
  -v "$cache/$key/venv:/venv" -v "$cache/uv:/uv-cache" \
  "$image" "$@"
