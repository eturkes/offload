#!/usr/bin/env python3
"""d28-one [REV] — run from a cement root: replay ONE D28 range revision (default: the newest)
exactly as `test_d28` does (detached worktree, battery unlinked, inner discover, rc 0 +
`Ran >= 949`) and record its green verdict under this interpreter's key. Prints
`d28-one: <rev> ran=<n> <secs>s`. Spike shortcut: range + replay steps copied from `test_d28`."""

import os
import pathlib
import subprocess
import sys
import time

sys.path.insert(0, ".")
from tests import test_migration_battery as m  # noqa: E402

root = m.ROOT
revisions = subprocess.run(
    ["git", "rev-list", "--reverse", f"{m.BASELINE}..HEAD", "--",
     ".agent/decisions/m3u6a1-surgery.py", "tests", "examples",
     ":(exclude)tests/test_migration_battery.py"],
    cwd=root, check=True, capture_output=True, text=True,
).stdout.split()
rev = sys.argv[1] if len(sys.argv) > 1 else revisions[-1]
assert rev in revisions, f"{rev} is outside the D28 range"
os.environ["CEMENT_D28_INNER_REPLAY"] = "1"
t0 = time.monotonic()
with m._detached_worktree(root, rev) as tree:
    (tree / "tests" / pathlib.Path(m.__file__).name).unlink(missing_ok=True)
    result = m._run([sys.executable, *m.D28_INNER], cwd=tree, root=tree, timeout=600)
output = result.stdout + result.stderr
assert result.returncode == 0, output[-2000:]
ran = int(m._required_match(r"(?m)^Ran (\d+) tests? in ", output).group(1))
assert ran >= 949, ran
m._d28_record(root, m._d28_content_key(root, rev), ran=ran, summary=output.rstrip().splitlines()[-1])
print(f"d28-one: {rev[:7]} ran={ran} {time.monotonic() - t0:.1f}s")
