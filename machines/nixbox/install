#!/bin/sh
# install <disk> — run from the controller while nixbox runs the installer ISO (installer.nix):
# wipes <disk> (GPT: 1 GiB ESP + LUKS2 ext4 root), creates Secure Boot keys, installs
# machines/nixbox, enrolls TPM2 (no PCRs yet; PCR 7 after firmware enrollment, README.md) +
# a recovery key → $RECOVERY_KEY, drops the setup keyfile, pulls back hardware-configuration.nix,
# reboots. Needs machines/nixbox/wifi.nix (gitignored).
set -eu
here=$(cd "$(dirname "$0")" && pwd)
disk=${1:?usage: install /dev/<disk>}
rk=${RECOVERY_KEY:-$HOME/.local/share/offload/nixbox-recovery-key}
ip=$(sed -n 's/.*address = "\(.*\)";/\1/p' "$here/host.nix")
# Installer host key is ephemeral → kept out of known_hosts.
o="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
[ -f "$here/wifi.nix" ] || { echo "install: $here/wifi.nix missing" >&2; exit 2; }
# Partition n of /dev/nvme0n1 = …p<n>, of /dev/sda = …<n>; lsblk order is unreliable.
case $disk in *[0-9]) esp=${disk}p1 luks=${disk}p2 ;; *) esp=${disk}1 luks=${disk}2 ;; esac
ssh $o "root@$ip" "set -eu
  umount -R /mnt 2>/dev/null || true
  cryptsetup close cryptroot 2>/dev/null || true
  [ -d /sys/firmware/efi ] || { echo 'install: box booted without UEFI' >&2; exit 2; }
  [ -e /dev/tpmrm0 ] || { echo 'install: no TPM' >&2; exit 2; }
  wipefs -af $disk
  parted -s $disk mklabel gpt mkpart ESP fat32 1MiB 1GiB set 1 esp on mkpart root 1GiB 100%
  udevadm settle
  umask 077
  head -c 64 /dev/urandom > /run/setup.key
  cryptsetup luksFormat -q --type luks2 --key-file /run/setup.key $luks
  cryptsetup open --key-file /run/setup.key $luks cryptroot
  mkfs.fat -F32 -n BOOT $esp
  mkfs.ext4 -qF -L nixos /dev/mapper/cryptroot
  udevadm settle
  # Explicit -t: the blkid cache can still hold the pre-mkfs signature.
  mount -t ext4 /dev/mapper/cryptroot /mnt
  mkdir -p /mnt/boot /mnt/var/lib
  mount -t vfat -o umask=077 $esp /mnt/boot
  nix-shell -p sbctl --run 'sbctl create-keys' >/dev/null
  cp -a /var/lib/sbctl /mnt/var/lib/
  nixos-generate-config --root /mnt"
scp -q $o "root@$ip:/mnt/etc/nixos/hardware-configuration.nix" "$here/"
grep -q 'luks.devices."cryptroot"' "$here/hardware-configuration.nix" || { echo "install: no cryptroot in hardware config" >&2; exit 1; }
scp -q $o "$here"/*.nix "root@$ip:/mnt/etc/nixos/"
ssh $o "root@$ip" "set -eu
  chmod 600 /mnt/etc/nixos/wifi.nix
  nixos-install --no-root-passwd
  # A reused disk keeps a Linux Boot Manager entry naming the old ESP; firmware then falls through to USB.
  nix-shell -p efibootmgr --run 'for b in \$(efibootmgr | sed -n \"s/^Boot\\([0-9A-F]*\\)\\* Linux Boot Manager.*/\\1/p\"); do efibootmgr -q -b \$b -B; done
    efibootmgr -q -c -d $disk -p 1 -L \"Linux Boot Manager\" -l \"\\\\EFI\\\\systemd\\\\systemd-bootx64.efi\"'
  systemd-cryptenroll --unlock-key-file=/run/setup.key --tpm2-device=auto --tpm2-pcrs= $luks"
# Recovery key: straight from the box into an owner-only file, never through logs.
mkdir -p "$(dirname "$rk")"
(umask 077; ssh $o "root@$ip" "systemd-cryptenroll --unlock-key-file=/run/setup.key --recovery-key $luks 2>&1" \
  | grep -oE '[a-z]{8}(-[a-z]{8}){7}' > "$rk")
[ "$(wc -l < "$rk")" = 1 ] || { echo "install: recovery key capture failed; setup keyfile kept" >&2; exit 1; }
ssh $o "root@$ip" "set -eu
  systemd-cryptenroll --unlock-key-file=/run/setup.key --wipe-slot=password $luks
  shred -u /run/setup.key
  systemd-cryptenroll $luks
  reboot"
