#!/bin/sh
# check [--dump | --facts FILE] — from the controller: nixbox findings an agent must act on. rc 0 =
# none, 1 = findings (one `check: …` line each), 2 = facts unavailable. Facts = lines collected as
# root over ssh (--dump prints them; --facts evaluates a saved or planted file instead):
#   now <epoch>                the box's clock.
#   upgrade <result> <epoch>   per nixos-upgrade.service start job in the persistent journal,
#                              oldest first: the last must be `done`, the last `done` ≤ 3 days old
#                              (daily timer ⇒ one missed day tolerated); else no one would notice.
#   failed <unit>              per failed system unit.
#   wrapper <name> <path>|-|?  per security wrapper, each `strings` line of its real program matching
#                              ^/(usr/)?s?bin/ (- = none, ? = real program not found). envfs
#                              (configuration.nix) resolves /bin + /usr/bin from the caller's PATH
#                              with no AT_SECURE check ⇒ every such exec by a setuid program needs a
#                              ruling in wrappers.reviewed; any other set = a finding.
#   sshd|fw|listen|secret …    configuration posture (owner: configuration flaws only, performance
#                              first): effective sshd settings, the nftables input policy + allow
#                              rules + temporarily opened ports, non-loopback listeners, files in the
#                              system closure holding the Wi-Fi PSK (read via a root-only temp file,
#                              never argv), wifi.env's mode — any set other than config.reviewed's =
#                              a finding.
set -eu
here=$(cd "$(dirname "$0")" && pwd)
ip=$(sed -n 's/.*address = "\(.*\)";/\1/p' "$here/host.nix")
collect() {
  ssh -o BatchMode=yes -o ForwardAgent=no -o ForwardX11=no -o ClearAllForwardings=yes -T \
    "offload@$ip" sudo sh -s <<'EOF'
set -eu
echo "now $(date +%s)"
journalctl -u nixos-upgrade.service JOB_TYPE=start -o json --no-pager |
  jq -r 'select(.JOB_RESULT != null) | "upgrade \(.JOB_RESULT) \(.__REALTIME_TIMESTAMP | tonumber / 1000000 | floor)"'
systemctl --failed --no-legend --plain | awk '{ print "failed " $1 }'
for w in /run/wrappers/bin/*; do
  n=${w##*/}
  # The wrapper binary embeds its real program's store path (NixOS wrapper.c, SOURCE_PROG).
  src=$(strings "$w" | grep -m1 -E '^/nix/store/[a-z0-9]{32}-[^/]+/(s?bin|libexec)/' || true)
  if [ -z "$src" ]; then
    echo "wrapper $n ?"
  else
    hits=$(strings "$src" | grep -E '^/(usr/)?s?bin/' | sort -u || true)
    [ -n "$hits" ] || hits=-
    printf '%s\n' "$hits" | sed "s|^|wrapper $n |"
  fi
done
/run/current-system/sw/bin/sshd -T -f /etc/ssh/sshd_config | awk 'tolower($1) ~ /^(passwordauthentication|kbdinteractiveauthentication|permitrootlogin|permitemptypasswords|pubkeyauthentication|clientaliveinterval|clientalivecountmax|x11forwarding|allowagentforwarding|allowtcpforwarding|gatewayports|permituserenvironment)$/ { print "sshd", tolower($1), tolower($2) }'
echo "fw input-policy $(nft -j list chain inet nixos-fw input | jq -r '.nftables[] | select(.chain) | .chain.policy')"
nft list chain inet nixos-fw input-allow | sed '1,/{/d; /^[[:space:]]*}/,$d; s/^[[:space:]]*//; s/ comment ".*"$//; /^$/d; s/^/fw allow /'
echo "fw temp-ports $(nft -j list set inet nixos-fw temp-ports | jq '[.nftables[] | select(.set) | .set.elem // [] | length] | add')"
ss -Hltnup | awk '$5 !~ /^(127\.|\[::1\])/ { match($7, /"[^"]+"/); print "listen", $1, $5, substr($7, RSTART + 1, RLENGTH - 2) }'
f=$(umask 077 && mktemp)
sed -n 's/^WIFI_PSK=//p' /etc/nixos/wifi.env >"$f"
if [ -s "$f" ]; then
  echo "secret psk-files $(nix-store -qR /run/current-system | xargs grep -rlF -f "$f" 2>/dev/null | wc -l)"
else
  echo "secret psk-files ?"
fi
rm -f "$f"
stat -c 'secret wifi.env %a %U' /etc/nixos/wifi.env
EOF
}
case ${1-} in
  '') facts=$(collect) || { echo "check: collecting facts from $ip failed" >&2; exit 2; } ;;
  --dump) collect; exit ;;
  --facts) facts=$(cat "${2:?usage: check [--dump | --facts FILE]}") ;;
  *) echo "usage: check [--dump | --facts FILE]" >&2; exit 2 ;;
esac
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
found=0
compare() { # compare <fact-word regex> <reviewed file>: facts ≠ the file's lines → findings
  printf '%s\n' "$facts" | grep -E "^($1) " | sort -u >"$tmp/seen" || true
  sed 's/[[:space:]]*#.*//; /^$/d' "$here/$2" | sort -u >"$tmp/reviewed"
  comm -23 "$tmp/seen" "$tmp/reviewed" | sed "s|^|check: unreviewed: |; s|\$| (rule it in $2)|"
  comm -13 "$tmp/seen" "$tmp/reviewed" | sed "s|^|check: reviewed but absent: |; s|\$| (update $2)|"
}
printf '%s\n' "$facts" | awk '
  $1 == "now" { now = $2 }
  $1 == "upgrade" { last = $2; at = $3; if ($2 == "done") ok = $3 }
  $1 == "failed" { print "check: failed unit " $2 }
  END {
    if (last == "") print "check: no nixos-upgrade run in the journal"
    else if (last != "done") printf "check: the last nixos-upgrade run ended %s (%d h ago)\n", last, (now - at) / 3600
    if (last != "" && (ok == "" || now - ok > 3 * 86400))
      printf "check: the last successful nixos-upgrade run is %s h old (> 72)\n", ok == "" ? "?" : int((now - ok) / 3600)
  }' | grep . && found=1
compare wrapper wrappers.reviewed | grep . && found=1
compare 'sshd|fw|listen|secret' config.reviewed | grep . && found=1
[ "$found" = 0 ] && echo "check: ok"
exit "$found"
